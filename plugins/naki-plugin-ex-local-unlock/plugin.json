{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "naki-plugin-ex-local-unlock",
  "name": "本機解鎖（naki-plugin-ex）",
  "version": "1.0.0",
  "entry": "plugin.js",
  "capabilities": [
    "rewriteReceive",
    "reshapeReceive"
  ],
  "methods": [
    ".lq.Lobby.login",
    ".lq.Lobby.oauth2Login",
    ".lq.Lobby.emailLogin",
    ".lq.FastTest.authGame",
    ".lq.NotifyAnotherLogin",
    ".lq.NotifyAccountLogout",
    ".lq.Lobby.fetchCharacterInfo",
    ".lq.Lobby.fetchAccountInfo",
    ".lq.Lobby.changeCharacterSkin",
    ".lq.Lobby.changeMainCharacter",
    ".lq.Lobby.changeAvatar",
    ".lq.Lobby.useTitle",
    ".lq.Lobby.setRandomCharacter",
    ".lq.Lobby.updateCharacterSort",
    ".lq.Lobby.setHiddenCharacter",
    ".lq.Lobby.changeCharacterView",
    ".lq.Lobby.changeCommonView",
    ".lq.Lobby.saveCommonViews",
    ".lq.Lobby.useCommonView",
    ".lq.Lobby.setLoadingImage",
    ".lq.Lobby.sendGiftToCharacter",
    ".lq.Lobby.upgradeCharacter",
    ".lq.Lobby.addFinishedEnding",
    ".lq.Lobby.receiveEndingReward",
    ".lq.Lobby.receiveCharacterRewards",
    ".lq.Lobby.mmoActivitySetCharacter",
    ".lq.Lobby.mmoActivitySetTeamMember"
  ],
  "sendGuard": [
    ".lq.Lobby.changeCharacterSkin",
    ".lq.Lobby.changeMainCharacter",
    ".lq.Lobby.changeAvatar",
    ".lq.Lobby.useTitle",
    ".lq.Lobby.setRandomCharacter",
    ".lq.Lobby.updateCharacterSort",
    ".lq.Lobby.setHiddenCharacter",
    ".lq.Lobby.changeCharacterView",
    ".lq.Lobby.changeCommonView",
    ".lq.Lobby.saveCommonViews",
    ".lq.Lobby.useCommonView",
    ".lq.Lobby.setLoadingImage",
    ".lq.Lobby.sendGiftToCharacter",
    ".lq.Lobby.upgradeCharacter",
    ".lq.Lobby.addFinishedEnding",
    ".lq.Lobby.receiveEndingReward",
    ".lq.Lobby.receiveCharacterRewards",
    ".lq.Lobby.mmoActivitySetCharacter",
    ".lq.Lobby.mmoActivitySetTeamMember"
  ],
  "priority": 100,
  "license": "CC0-1.0",
  "settingsUI": "settings.html",
  "settings": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "啟用本機外觀覆寫"
    },
    "testAccountAck": {
      "type": "boolean",
      "default": false,
      "description": "我確認只在測試帳號使用（未勾選時插件不做任何改寫）"
    },
    "titleId": {
      "type": "number",
      "default": 0,
      "description": "稱號 id，用於對局內與大廳個人資料（0＝不覆寫）"
    },
    "views": {
      "type": "string",
      "default": "",
      "description": "對局內裝扮覆寫，格式 slot=itemId，以逗號分隔"
    },
    "characterId": {
      "type": "number",
      "default": 0,
      "description": "大廳主角色 id（與皮膚 id 同時填才生效，0＝不覆寫）"
    },
    "skinId": {
      "type": "number",
      "default": 0,
      "description": "主角色顯示的皮膚 id，也用作個人資料頭像（0＝不覆寫）"
    }
  },
  "description": "只改這台裝置上自家的外觀顯示：大廳主角色、皮膚、頭像、稱號，以及對局內稱號與裝扮。伺服器永遠不會收到使用未擁有物品的換裝請求：改過顯示後，換裝類請求一律在本機拒送。不送出任何請求。id 由使用者在設定頁手動輸入。需要 Naki 2.20.0 以上。只在測試帳號使用，存在封號風險。設定變更後須重新載入遊戲頁面並重新登入才生效。"
}
