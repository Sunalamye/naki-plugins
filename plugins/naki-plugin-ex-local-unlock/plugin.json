{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "naki-plugin-ex-local-unlock",
  "name": "本機解鎖（naki-plugin-ex）",
  "version": "0.1.0",
  "entry": "plugin.js",
  "capabilities": [
    "rewriteReceive"
  ],
  "methods": [
    ".lq.Lobby.login",
    ".lq.Lobby.oauth2Login",
    ".lq.Lobby.emailLogin",
    ".lq.FastTest.authGame",
    ".lq.NotifyAnotherLogin",
    ".lq.NotifyAccountLogout"
  ],
  "priority": 100,
  "license": "CC0-1.0",
  "settingsUI": "settings.html",
  "settings": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "啟用本機外觀覆寫"
    },
    "testAccountAck": {
      "type": "boolean",
      "default": false,
      "description": "我確認只在測試帳號使用（未勾選時插件不做任何改寫）"
    },
    "titleId": {
      "type": "number",
      "default": 0,
      "description": "對局內顯示的稱號 id（0＝不覆寫）"
    },
    "views": {
      "type": "string",
      "default": "",
      "description": "對局內裝扮覆寫，格式 slot=itemId，以逗號分隔"
    }
  },
  "description": "只改這台裝置上對局內自家的稱號與裝扮顯示，不送出任何請求。id 由使用者在設定頁手動輸入。只在測試帳號使用，存在封號風險。設定變更後須重新載入遊戲頁面並重新登入才生效。"
}
