{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "naki-plugin-ex-tile-highlighter",
  "name": "牌面變色（naki-plugin-ex）",
  "version": "1.3.0",
  "entry": "plugin.js",
  "capabilities": [
    "observe"
  ],
  "methods": [
    ".lq.ActionPrototype"
  ],
  "priority": 100,
  "license": "CC0-1.0",
  "settingsUI": "settings.html",
  "settings": {
    "color": {
      "type": "string",
      "default": "green",
      "description": "推薦牌顏色 green/red/blue"
    },
    "dimOthers": {
      "type": "boolean",
      "default": true,
      "description": "淡化其餘手牌（需要新版 Naki）"
    }
  },
  "description": "推薦更新即時染色；最佳棄牌/立直高亮、其餘手牌淡化、副露組合橙色。關閉時清除。舊版 Naki 僅支援封包觸發的有限相容模式。"
}
